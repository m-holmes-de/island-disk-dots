#!/usr/bin/env bash
set -euo pipefail

# ── Restore Postgres Backup ────────────────────────────────────────────────
# Restores a postgres backup (made by backup-street) into either a
# persistent container (default) or a throwaway one for verification.
#
# Usage:
#   restore-postgres                       # interactive restore to new container
#   restore-postgres <backup-dir>          # restore specific backup
#   restore-postgres --verify              # throwaway + compare to source
#   restore-postgres --verify <backup-dir>
#
# A "backup-dir" is a container folder like:
#   /path/to/backup-street/<host>-<date>/postgres/<container-name>/
#
# Requires: docker, gzip. Optional: jq (for metadata), gum (prettier TUI).

# ── Colors ──────────────────────────────────────────────────────────────────
C_BOLD='\033[1m'
C_DIM='\033[2m'
C_BLUE='\033[0;34m'
C_GREEN='\033[0;32m'
C_YELLOW='\033[1;33m'
C_RED='\033[0;31m'
C_CYAN='\033[0;36m'
C_NC='\033[0m'

info()    { echo -e "${C_BLUE}  ▸${C_NC} $1"; }
success() { echo -e "${C_GREEN}  ✓${C_NC} $1"; }
warn()    { echo -e "${C_YELLOW}  !${C_NC} $1"; }
error()   { echo -e "${C_RED}  ✗${C_NC} $1"; }

USE_GUM=false
command -v gum &>/dev/null && USE_GUM=true

confirm() {
  local prompt="$1"
  if $USE_GUM; then
    gum confirm "$prompt"
  else
    read -rp "  $prompt [y/N] " answer
    [[ "$answer" =~ ^[Yy] ]]
  fi
}

prompt_input() {
  local label="$1" default="${2:-}" value
  if $USE_GUM; then
    value=$(gum input --placeholder "$default" --value "$default" --prompt "  $label: ")
  else
    read -rp "  $label [$default]: " value
    [[ -z "$value" ]] && value="$default"
  fi
  echo "$value"
}

header() {
  local title="$1"
  echo ""
  if $USE_GUM; then
    gum style --border rounded --border-foreground 63 --padding "0 2" --bold \
      "🐘 Restore Postgres Backup" \
      "   $title"
  else
    echo -e "${C_BOLD}${C_CYAN}╭────────────────────────────────────╮${C_NC}"
    echo -e "${C_BOLD}${C_CYAN}│  Restore Postgres Backup           │${C_NC}"
    echo -e "${C_BOLD}${C_CYAN}│  $title${C_NC}"
    echo -e "${C_BOLD}${C_CYAN}╰────────────────────────────────────╯${C_NC}"
  fi
  echo ""
}

# ── Mode / args ─────────────────────────────────────────────────────────────
MODE="restore"   # restore | verify
BACKUP_DIR=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --verify) MODE="verify"; shift ;;
    --restore) MODE="restore"; shift ;;
    -h|--help)
      sed -n '3,16p' "$0" | sed 's/^# //;s/^#//'
      exit 0 ;;
    *)
      if [[ -z "$BACKUP_DIR" ]]; then
        BACKUP_DIR="$1"
        shift
      else
        error "Unknown argument: $1"
        exit 1
      fi
      ;;
  esac
done

# ── Shared: find free port ─────────────────────────────────────────────────
find_free_port() {
  local port="${1:-5433}"
  while ss -tln 2>/dev/null | awk '{print $4}' | grep -qE ":${port}$"; do
    ((port++))
    [[ $port -gt 5600 ]] && { echo "no free port" >&2; return 1; }
  done
  echo "$port"
}

# ── Shared: pick backup dir ────────────────────────────────────────────────
pick_backup_dir() {
  if [[ -n "$BACKUP_DIR" ]]; then
    echo "$BACKUP_DIR"
    return
  fi

  local candidates=()
  for base in /run/media/"$USER"/*/backup-street /mnt/*/backup-street /media/"$USER"/*/backup-street; do
    [[ -d "$base" ]] || continue
    while IFS= read -r container_dir; do
      candidates+=("$container_dir")
    done < <(find "$base" -mindepth 3 -maxdepth 3 -type d -path '*/postgres/*' 2>/dev/null | sort -r)
  done

  if [[ ${#candidates[@]} -eq 0 ]]; then
    error "No postgres backups found. Pass a path as argument."
    exit 1
  fi

  info "Select a backup:" >&2
  if $USE_GUM; then
    gum choose --header "  Backup dir:" "${candidates[@]}"
  else
    local i=1
    for c in "${candidates[@]}"; do
      echo -e "    ${C_BOLD}$i)${C_NC} ${c#/run/media/$USER/}" >&2
      ((i++))
    done
    echo "" >&2
    read -rp "  Choose [1-${#candidates[@]}]: " choice
    echo "${candidates[$((choice - 1))]}"
  fi
}

# ── Shared: read metadata.json ─────────────────────────────────────────────
read_metadata() {
  local backup_dir="$1" key="$2" default="${3:-}"
  local meta="$backup_dir/metadata.json"
  [[ ! -f "$meta" ]] && { echo "$default"; return; }
  if command -v jq &>/dev/null; then
    local value
    value=$(jq -r ".${key} // empty" "$meta" 2>/dev/null)
    [[ -z "$value" || "$value" == "null" ]] && value="$default"
    echo "$value"
  else
    # Very basic fallback: grep "key": "value"
    grep -oP "\"${key}\"\\s*:\\s*\"[^\"]*\"" "$meta" 2>/dev/null \
      | sed -E "s/\"${key}\"\\s*:\\s*\"([^\"]*)\"/\\1/" | head -1 \
      | { read -r v; [[ -z "$v" ]] && echo "$default" || echo "$v"; }
  fi
}

# Determine the in-container data mount path for this restore:
# 1. Prefer the Destination from metadata.json's first mount (matches source)
# 2. For postgres:14+ default to /var/lib/postgresql (new layout)
# 3. For older images, /var/lib/postgresql/data
detect_mount_destination() {
  local backup_dir="$1" image="$2" dest=""
  local meta="$backup_dir/metadata.json"

  if [[ -f "$meta" ]] && command -v jq &>/dev/null; then
    dest=$(jq -r '.mounts[0].Destination // empty' "$meta" 2>/dev/null)
  fi

  if [[ -z "$dest" ]]; then
    # Extract major version from image tag (e.g. postgres:18, postgres:16-alpine)
    local major
    major=$(echo "$image" | sed -nE 's/.*:([0-9]+).*/\1/p')
    if [[ -n "$major" ]] && (( major >= 18 )); then
      dest="/var/lib/postgresql"
    else
      dest="/var/lib/postgresql/data"
    fi
  fi

  echo "$dest"
}

# ── Shared: wait for postgres ready ────────────────────────────────────────
wait_for_postgres() {
  local container="$1"
  info "Waiting for postgres to accept connections..."
  for i in {1..30}; do
    if docker exec "$container" pg_isready -U postgres &>/dev/null; then
      success "Postgres is ready"
      return 0
    fi
    sleep 1
  done
  error "Postgres did not start in 30 seconds"
  docker logs "$container" | tail -20
  return 1
}

# ── Shared: restore pg_dumpall ─────────────────────────────────────────────
restore_dumpall() {
  local container="$1" dumpall="$2"
  info "Restoring $dumpall..."
  local start_time elapsed
  start_time=$(date +%s)
  if gunzip < "$dumpall" | docker exec -i "$container" psql -U postgres -q &>/tmp/restore-postgres.log; then
    elapsed=$(( $(date +%s) - start_time ))
    success "Restored in ${elapsed}s"
    return 0
  else
    error "Restore failed — see /tmp/restore-postgres.log"
    tail -20 /tmp/restore-postgres.log
    return 1
  fi
}

# ── Shared: list databases ─────────────────────────────────────────────────
list_restored_dbs() {
  local container="$1"
  info "Restored databases:"
  docker exec "$container" psql -U postgres -tAc \
    "SELECT datname FROM pg_database WHERE datistemplate = false AND datname <> 'postgres';" \
    | while read -r db; do
        [[ -z "$db" ]] && continue
        size=$(docker exec "$container" psql -U postgres -tAc "SELECT pg_size_pretty(pg_database_size('$db'))")
        echo -e "    ${C_CYAN}$db${C_NC} ${C_DIM}($size)${C_NC}"
      done
}

# ═══════════════════════════════════════════════════════════════════════════
# VERIFY MODE — throwaway container + row-count comparison
# ═══════════════════════════════════════════════════════════════════════════

run_verify() {
  header "verify (throwaway)"

  BACKUP_DIR="$(pick_backup_dir)"
  [[ -z "$BACKUP_DIR" ]] && { error "No backup selected"; exit 1; }
  [[ ! -d "$BACKUP_DIR" ]] && { error "Not a directory: $BACKUP_DIR"; exit 1; }

  local DUMPALL="$BACKUP_DIR/pg_dumpall.sql.gz"
  [[ ! -f "$DUMPALL" ]] && { error "pg_dumpall.sql.gz not found in $BACKUP_DIR"; exit 1; }

  local SOURCE_CONTAINER TEST_CONTAINER TEST_PORT TEST_PASSWORD TEST_IMAGE
  SOURCE_CONTAINER="$(basename "$BACKUP_DIR")"
  TEST_CONTAINER="pg-restore-test-$$"
  TEST_PORT="$(find_free_port)"
  TEST_PASSWORD="verify-$(date +%s)"
  TEST_IMAGE="$(read_metadata "$BACKUP_DIR" image postgres:18)"

  info "Backup:           ${C_BOLD}$BACKUP_DIR${C_NC}"
  info "Source container: ${C_BOLD}$SOURCE_CONTAINER${C_NC}"
  info "Test container:   ${C_BOLD}$TEST_CONTAINER${C_NC} (port $TEST_PORT)"
  info "Image:            $TEST_IMAGE"
  info "Dump size:        $(du -h "$DUMPALL" | cut -f1)"
  echo ""

  local SOURCE_USER="" COMPARE=false
  if docker ps --format '{{.Names}}' | grep -q "^${SOURCE_CONTAINER}$"; then
    info "Source container is running — row counts will be compared"
    for u in postgres root admin; do
      if docker exec "$SOURCE_CONTAINER" psql -U "$u" -tAc 'SELECT 1' &>/dev/null; then
        SOURCE_USER="$u"
        break
      fi
    done
    if [[ -n "$SOURCE_USER" ]]; then
      COMPARE=true
      success "Authenticated as '$SOURCE_USER' on source"
    else
      warn "Could not authenticate to source — skipping comparison"
    fi
  else
    warn "Source container '$SOURCE_CONTAINER' not running — skipping comparison"
  fi
  echo ""

  confirm "Start test container and restore?" || exit 0
  echo ""

  # Cleanup trap
  cleanup_test() {
    if docker ps -a --format '{{.Names}}' | grep -q "^${TEST_CONTAINER}$"; then
      echo ""
      info "Cleaning up test container..."
      docker rm -f "$TEST_CONTAINER" &>/dev/null || true
      success "Removed $TEST_CONTAINER"
    fi
  }
  trap cleanup_test EXIT INT TERM

  info "Starting $TEST_IMAGE on port $TEST_PORT..."
  docker run -d --rm \
    --name "$TEST_CONTAINER" \
    -e POSTGRES_PASSWORD="$TEST_PASSWORD" \
    -p "$TEST_PORT:5432" \
    "$TEST_IMAGE" >/dev/null

  wait_for_postgres "$TEST_CONTAINER" || exit 1
  echo ""
  restore_dumpall "$TEST_CONTAINER" "$DUMPALL" || exit 1
  echo ""
  list_restored_dbs "$TEST_CONTAINER"
  echo ""

  # Row count comparison
  if $COMPARE; then
    info "Comparing row counts (source vs restored)..."
    echo ""

    local SRC_FILE TEST_FILE DIFF_FILE
    SRC_FILE=$(mktemp)
    TEST_FILE=$(mktemp)
    DIFF_FILE=$(mktemp)

    collect_row_counts "$SOURCE_CONTAINER" "$SOURCE_USER" > "$SRC_FILE"
    collect_row_counts "$TEST_CONTAINER" postgres > "$TEST_FILE"

    info "Tables in source:   $(wc -l < "$SRC_FILE")"
    info "Tables in restored: $(wc -l < "$TEST_FILE")"
    echo ""

    diff "$SRC_FILE" "$TEST_FILE" > "$DIFF_FILE" || true

    if [[ ! -s "$DIFF_FILE" ]]; then
      success "All row counts match — backup verified ✓"
    else
      warn "Row count differences detected:"
      echo ""
      head -40 "$DIFF_FILE" | sed 's/^/    /'
      local diff_lines
      diff_lines=$(wc -l < "$DIFF_FILE")
      [[ "$diff_lines" -gt 40 ]] && echo -e "    ${C_DIM}... ($((diff_lines - 40)) more lines)${C_NC}"
      echo ""
      info "Full diff: ${C_BOLD}$DIFF_FILE${C_NC}"
      warn "Note: small diffs can be normal if source changed during/after backup"
    fi
    rm -f "$SRC_FILE" "$TEST_FILE"
  else
    warn "Comparison skipped."
  fi

  echo ""
  info "Test container is running at localhost:$TEST_PORT"
  info "Connect with:"
  echo -e "    ${C_DIM}PGPASSWORD=$TEST_PASSWORD psql -h localhost -p $TEST_PORT -U postgres${C_NC}"
  echo ""

  if ! confirm "Destroy test container now?"; then
    trap - EXIT INT TERM
    info "Test container left running: ${C_BOLD}$TEST_CONTAINER${C_NC}"
    info "Clean up manually with: ${C_BOLD}docker rm -f $TEST_CONTAINER${C_NC}"
    exit 0
  fi
  echo ""
}

# collect_row_counts <container> <user>
collect_row_counts() {
  local container="$1" user="$2" dbs db sql union_sql
  dbs=$(docker exec "$container" psql -U "$user" -tAc \
    "SELECT datname FROM pg_database WHERE datistemplate = false AND datname <> 'postgres';" 2>/dev/null)

  while IFS= read -r db; do
    [[ -z "$db" ]] && continue
    sql=$(cat <<'EOF'
SELECT string_agg(
  format('SELECT %L AS db, %L AS tbl, count(*)::bigint AS n FROM %I.%I',
         current_database(), schemaname || '.' || tablename, schemaname, tablename),
  ' UNION ALL '
)
FROM pg_tables
WHERE schemaname NOT IN ('pg_catalog','information_schema');
EOF
)
    union_sql=$(docker exec "$container" psql -U "$user" -d "$db" -tAc "$sql" 2>/dev/null)
    if [[ -n "$union_sql" && "$union_sql" != " " ]]; then
      docker exec "$container" psql -U "$user" -d "$db" -tAF $'\t' -c \
        "SELECT db, tbl, n FROM ($union_sql) x ORDER BY tbl" 2>/dev/null
    fi
  done <<< "$dbs"
}

# ═══════════════════════════════════════════════════════════════════════════
# RESTORE MODE — persistent container with user-chosen params
# ═══════════════════════════════════════════════════════════════════════════

run_restore() {
  header "restore (persistent)"

  BACKUP_DIR="$(pick_backup_dir)"
  [[ -z "$BACKUP_DIR" ]] && { error "No backup selected"; exit 1; }
  [[ ! -d "$BACKUP_DIR" ]] && { error "Not a directory: $BACKUP_DIR"; exit 1; }

  local DUMPALL="$BACKUP_DIR/pg_dumpall.sql.gz"
  [[ ! -f "$DUMPALL" ]] && { error "pg_dumpall.sql.gz not found in $BACKUP_DIR"; exit 1; }

  # Load metadata defaults
  local meta_container meta_image meta_port meta_user meta_version
  meta_container=$(read_metadata "$BACKUP_DIR" container "$(basename "$BACKUP_DIR")")
  meta_image=$(read_metadata "$BACKUP_DIR" image postgres:18)
  meta_port=$(read_metadata "$BACKUP_DIR" original_port 5432)
  meta_user=$(read_metadata "$BACKUP_DIR" user postgres)
  meta_version=$(read_metadata "$BACKUP_DIR" version "unknown")

  info "Backup:     ${C_BOLD}$BACKUP_DIR${C_NC}"
  info "Dump size:  $(du -h "$DUMPALL" | cut -f1)"
  if [[ -f "$BACKUP_DIR/metadata.json" ]]; then
    info "Metadata found:"
    echo -e "    ${C_DIM}original container: ${meta_container}${C_NC}"
    echo -e "    ${C_DIM}image:              ${meta_image}${C_NC}"
    echo -e "    ${C_DIM}original port:      ${meta_port}${C_NC}"
    echo -e "    ${C_DIM}postgres version:   ${meta_version}${C_NC}"
  else
    warn "No metadata.json — using defaults"
  fi
  echo ""

  # ── Prompt user for restore params (auto-populated from metadata) ──
  info "Container configuration:"
  echo ""

  local default_name="${meta_container}-restored"
  local new_container new_image new_volume new_port new_password

  new_container=$(prompt_input "Container name" "$default_name")
  # Guard against collision
  while docker ps -a --format '{{.Names}}' | grep -q "^${new_container}$"; do
    warn "Container '$new_container' already exists"
    new_container=$(prompt_input "Pick another name" "${new_container}-$(date +%s)")
  done

  new_image=$(prompt_input "Image" "$meta_image")
  new_volume=$(prompt_input "Volume name" "${new_container}-data")
  new_port=$(prompt_input "Host port" "$(find_free_port "${meta_port:-5433}")")
  new_password=$(prompt_input "Password" "$(openssl rand -hex 12 2>/dev/null || date +%s%N | sha256sum | head -c 24)")

  echo ""
  echo -e "  ${C_BOLD}Summary${C_NC}"
  echo -e "  ${C_DIM}─────────────────────────────────────${C_NC}"
  echo -e "  Container: ${C_CYAN}$new_container${C_NC}"
  echo -e "  Image:     $new_image"
  echo -e "  Volume:    $new_volume"
  echo -e "  Port:      $new_port"
  echo -e "  Password:  $new_password"
  echo -e "  ${C_DIM}─────────────────────────────────────${C_NC}"
  echo ""

  confirm "Proceed with restore?" || exit 0
  echo ""

  # ── Create volume and start container ──
  if ! docker volume inspect "$new_volume" &>/dev/null; then
    info "Creating volume $new_volume..."
    docker volume create "$new_volume" >/dev/null
  fi

  local mount_dest
  mount_dest=$(detect_mount_destination "$BACKUP_DIR" "$new_image")
  info "Mount destination: $mount_dest"

  info "Starting $new_image..."
  docker run -d \
    --name "$new_container" \
    -e POSTGRES_PASSWORD="$new_password" \
    -p "$new_port:5432" \
    -v "$new_volume:$mount_dest" \
    "$new_image" >/dev/null
  success "Container started: $new_container"

  wait_for_postgres "$new_container" || {
    error "Container failed to become ready. See: docker logs $new_container"
    exit 1
  }
  echo ""

  # ── Default: restore full cluster; option to pick specific DBs ──
  if confirm "Restore specific databases only? (default: full cluster via pg_dumpall)"; then
    restore_selected_dbs "$new_container" "$BACKUP_DIR"
  else
    restore_dumpall "$new_container" "$DUMPALL" || {
      error "Restore failed but container is running: $new_container"
      exit 1
    }
  fi
  echo ""

  list_restored_dbs "$new_container"
  echo ""

  # ── Save restore metadata next to backup ──
  local restore_log="$HOME/.local/state/backup-street/restores.log"
  mkdir -p "$(dirname "$restore_log")"
  {
    echo "$(date -Iseconds)  container=$new_container  image=$new_image  port=$new_port  backup=$BACKUP_DIR"
  } >> "$restore_log"

  echo ""
  success "============================================"
  success "Restore complete!"
  success "============================================"
  echo ""
  info "Container: ${C_BOLD}$new_container${C_NC}"
  info "Connect with:"
  echo -e "    ${C_DIM}PGPASSWORD='$new_password' psql -h localhost -p $new_port -U postgres${C_NC}"
  echo ""
  info "Stop:    docker stop $new_container"
  info "Start:   docker start $new_container"
  info "Remove:  docker rm -f $new_container && docker volume rm $new_volume"
  echo ""
}

restore_selected_dbs() {
  local container="$1" backup_dir="$2"
  local db_dir="$backup_dir/databases"

  if [[ ! -d "$db_dir" ]]; then
    error "No databases/ directory in $backup_dir"
    return 1
  fi

  local dumps=()
  while IFS= read -r f; do
    dumps+=("$(basename "$f" .dump)")
  done < <(find "$db_dir" -maxdepth 1 -name '*.dump' | sort)

  if [[ ${#dumps[@]} -eq 0 ]]; then
    error "No .dump files found in $db_dir"
    return 1
  fi

  info "Available databases:"
  for d in "${dumps[@]}"; do
    echo -e "    ${C_DIM}$d${C_NC}"
  done
  echo ""

  local selected
  if $USE_GUM; then
    selected=$(printf '%s\n' "${dumps[@]}" | \
      gum choose --no-limit --header "  Select databases to restore:")
  else
    selected=$(printf '%s\n' "${dumps[@]}" | \
      fzf --multi --prompt="  Select databases (Tab to toggle): " \
          --header="  Databases" --height=40% --reverse --border)
  fi

  [[ -z "$selected" ]] && { warn "No databases selected"; return 0; }

  while IFS= read -r db; do
    [[ -z "$db" ]] && continue
    info "Restoring $db..."
    # Create DB if not exists
    docker exec "$container" psql -U postgres -tAc \
      "SELECT 1 FROM pg_database WHERE datname='$db'" | grep -q 1 || \
      docker exec "$container" psql -U postgres -c "CREATE DATABASE \"$db\""
    # Restore
    if docker exec -i "$container" pg_restore -U postgres -d "$db" --no-owner --no-acl \
        < "$db_dir/${db}.dump" &>>/tmp/restore-postgres.log; then
      success "$db"
    else
      warn "$db restored with warnings — see /tmp/restore-postgres.log"
    fi
  done <<< "$selected"
}

# ═══════════════════════════════════════════════════════════════════════════
# Main
# ═══════════════════════════════════════════════════════════════════════════

if ! command -v docker &>/dev/null; then
  error "docker not found"
  exit 1
fi

case "$MODE" in
  verify)  run_verify ;;
  restore) run_restore ;;
esac
