font-family = JetBrainsMono Nerd Font
font-size = 15
font-style = Bold
adjust-cell-height = 0
adjust-cell-width = 0
window-padding-x = 6
window-padding-y = 6
window-save-state = always
# theme = Rose Pine Moon
# theme = Catppuccin Mocha
# theme = GitHub Dark
theme = Atom One Dark
title = " "
cursor-opacity = 0.8
cursor-style = block
cursor-style-blink = false
macos-titlebar-style = hidden
window-decoration = true
shell-integration-features = no-cursor
window-theme = dark
# macos-option-as-alt = left
# Custom background colors
# background = #0d1117 # GitHub dark background
# background = #16161e # Subtle warm dark gray - easy on eyes, minimal
# background = #191724 # Rose Pine base - deep purple-tinted dark
# Rose Pine Moon default background
# background = #232136
background-opacity = 1
background-blur = false
split-divider-color = #303030
unfocused-split-opacity = 0.95
clipboard-read = allow

# Vim-style pane navigation
# keybind = ctrl+h=goto_split:left
# keybind = ctrl+j=goto_split:bottom
# keybind = ctrl+k=goto_split:top
# keybind = ctrl+l=goto_split:right

# Tmux-style split creation (ctrl-space as leader)
# keybind = ctrl+space>h=new_split:left
# keybind = ctrl+space>j=new_split:down
# keybind = ctrl+space>k=new_split:up
# keybind = ctrl+space>l=new_split:right
# keybind = ctrl+space>x=close_surface
# keybind = ctrl+space>m=toggle_split_zoom
# keybind = ctrl+space>t=toggle_quick_terminal
keybind = shift+enter=text:\x1b\r
