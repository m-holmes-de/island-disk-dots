# Rose Pine theme for Yazi with black background
# Colors from rose-pine palette

[manager]
cwd = { fg = "#e0def4" }

# Hovered
hovered         = { fg = "#e0def4", bg = "#191724" }
preview_hovered = { underline = true }

# Find
find_keyword  = { fg = "#f6c177", italic = true }
find_position = { fg = "#c4a7e7", bg = "reset", italic = true }

# Marker
marker_selected = { fg = "#9ccfd8", bg = "#9ccfd8" }
marker_copied   = { fg = "#f6c177", bg = "#f6c177" }
marker_cut      = { fg = "#eb6f92", bg = "#eb6f92" }

# Tab
tab_active   = { fg = "#000000", bg = "#c4a7e7" }
tab_inactive = { fg = "#908caa", bg = "#191724" }
tab_width    = 1

# Border
border_symbol = "│"
border_style  = { fg = "#524f67" }

# Highlighting
syntect_theme = ""

[status]
separator_open  = ""
separator_close = ""
separator_style = { fg = "#191724", bg = "#191724" }

# Mode
mode_normal = { fg = "#000000", bg = "#9ccfd8", bold = true }
mode_select = { fg = "#000000", bg = "#f6c177", bold = true }
mode_unset  = { fg = "#000000", bg = "#eb6f92", bold = true }

# Progress
progress_label  = { fg = "#e0def4", bold = true }
progress_normal = { fg = "#9ccfd8", bg = "#191724" }
progress_error  = { fg = "#eb6f92", bg = "#191724" }

# Permissions
permissions_t = { fg = "#9ccfd8" }
permissions_r = { fg = "#f6c177" }
permissions_w = { fg = "#eb6f92" }
permissions_x = { fg = "#ebbcba" }
permissions_s = { fg = "#908caa" }

[input]
border   = { fg = "#9ccfd8" }
title    = {}
value    = {}
selected = { reversed = true }

[select]
border   = { fg = "#9ccfd8" }
active   = { fg = "#c4a7e7" }
inactive = {}

[tasks]
border  = { fg = "#9ccfd8" }
title   = {}
hovered = { underline = true }

[which]
mask            = { bg = "#000000" }
cand            = { fg = "#9ccfd8" }
rest            = { fg = "#908caa" }
desc            = { fg = "#c4a7e7" }
separator       = "  "
separator_style = { fg = "#524f67" }

[help]
on      = { fg = "#c4a7e7" }
exec    = { fg = "#9ccfd8" }
desc    = { fg = "#908caa" }
hovered = { bg = "#524f67", bold = true }
footer  = { fg = "#191724", bg = "#e0def4" }

[filetype]

rules = [
	# Images
	{ mime = "image/*", fg = "#9ccfd8" },

	# Videos
	{ mime = "video/*", fg = "#f6c177" },
	{ mime = "audio/*", fg = "#f6c177" },

	# Archives
	{ mime = "application/zip",             fg = "#c4a7e7" },
	{ mime = "application/gzip",            fg = "#c4a7e7" },
	{ mime = "application/x-tar",           fg = "#c4a7e7" },
	{ mime = "application/x-bzip",          fg = "#c4a7e7" },
	{ mime = "application/x-bzip2",         fg = "#c4a7e7" },
	{ mime = "application/x-7z-compressed", fg = "#c4a7e7" },
	{ mime = "application/x-rar",           fg = "#c4a7e7" },

	# Documents
	{ mime = "application/pdf", fg = "#eb6f92" },

	# Fallback
	{ name = "*", fg = "#e0def4" },
	{ name = "*/", fg = "#9ccfd8" }
]
